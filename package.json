{
  "name": "picagent-suite-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:encoding": "node scripts/check-utf8-docs.mjs src tests",
    "pretest": "npm run check:encoding",
    "prebuild": "npm run check:encoding",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:e2e": "playwright test tests/e2e/asset-product-boundary.spec.ts tests/e2e/hero-suite-workspace.spec.ts tests/e2e/prompt-marketplace-categories.spec.ts tests/e2e/generation-config.spec.ts tests/e2e/generation-config-prompt-loading.spec.ts tests/e2e/workbench-board.spec.ts tests/e2e/image-editing-product-flow.spec.ts tests/e2e/product-library-publish.spec.ts tests/e2e/workspace-recent-project.spec.ts",
    "test:ticket05": "tsx --test tests/ticket05.contract.test.ts tests/ticket05.input.test.ts",
    "test:ticket02": "tsx --test tests/ticket02.contract.test.ts tests/ticket02.encoding.test.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.206.0",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-virtual": "^3.14.11",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "konva": "^10.3.2",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-konva": "^19.2.5",
    "react-resizable-panels": "^4.12.4",
    "react-router-dom": "^7.18.3",
    "react-window": "^2.3.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
